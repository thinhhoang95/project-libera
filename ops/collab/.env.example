# Production environment for ops/collab/docker-compose.prod.yml.
# Copy to /srv/libera-collab/.env on the server (mode 0600). Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
PUBLIC_URL=https://collab.libera.intuelle.com
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
ALLOW_OPEN_SIGNUP=0
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=Libera <no-reply@libera.intuelle.com>
MIN_APP_VERSION=6.5.0
METRICS_TOKEN=change-me
LOG_LEVEL=info
# Error reports to a Sentry-compatible server (self-hosted GlitchTip). Optional.
# ERROR_REPORT_DSN=https://key@glitchtip.example.com/1
