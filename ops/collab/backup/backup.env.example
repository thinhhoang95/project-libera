# Settings for backup.sh and restore-drill.sh. Copy to /srv/libera-collab/backup.env
# (mode 0600, root only). Every line is optional; the defaults are shown.

# BACKUP_DIR=/srv/libera-collab/backups
# KEEP_DAILY=14
# KEEP_WEEKLY=8
# Base backups kept for point-in-time recovery; the WAL archive is pruned to
# the oldest of them, so this sets the PITR window (4 = about four weeks).
# BASE_BACKUPS_KEEP=4
# KEEP_BLOB_SETS=8
# Day of the weekly dump, base backup and level-0 blob tar (1 = Monday ... 7 = Sunday).
# WEEKLY_DAY=7

# Off-site copy, either an rclone remote you configured with `rclone config`
# (any backend; wrap it in an rclone crypt remote to encrypt):
# OFFSITE_RCLONE_REMOTE=offsite-crypt:libera-collab
# or an S3-compatible endpoint (credentials stay in the environment):
# OFFSITE_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# OFFSITE_S3_BUCKET=libera-collab-backups
# OFFSITE_S3_PREFIX=libera-collab
# OFFSITE_S3_REGION=eu-central-003
# OFFSITE_S3_PROVIDER=Other
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=

# Pinged after every successful backup (healthchecks.io or similar), so a
# missed night raises an alarm.
# BACKUP_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# Restore drill: published port of the drill server (127.0.0.1 only).
# DRILL_PORT=4410
