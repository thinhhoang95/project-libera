{
  "name": "project-libera",
  "productName": "Libera by Thinh Hoang",
  "version": "0.7.2",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "deps:setup": "node scripts/platform-deps.cjs install",
    "deps:status": "node scripts/platform-deps.cjs status",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "cross-env LIBERA_ELECTRON_NEXT_MODE=dev electron .",
    "electron:prepare-standalone": "node electron/prepare-standalone.cjs",
    "electron:prepare-dist": "node electron/prepare-dist.cjs",
    "electron:start": "npm run build && npm run electron:prepare-standalone && cross-env LIBERA_ELECTRON_NEXT_MODE=start electron .",
    "electron:dist": "npm run build && npm run electron:prepare-standalone && npm run electron:prepare-dist && electron-builder --config electron-builder.json",
    "electron:dist:mac:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run electron:dist -- --mac --arm64 -c.mac.identity=null -c.mac.notarize=false",
    "electron:dist:win": "npm run electron:dist -- --win --x64",
    "electron:dist:win:safe": "node scripts/platform-deps.cjs run electron:dist:win",
    "electron:release:mac": "node scripts/release-electron.cjs --platform mac",
    "electron:release:win": "node scripts/release-electron.cjs --platform win",
    "electron:update-server:setup": "node scripts/setup-update-server.cjs",
    "test:electron-release": "node --test scripts/**/*.test.cjs",
    "test:editor": "node --import tsx --test scripts/editor/*.test.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "electron": "^37.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "js-yaml": "^4.3.1",
    "jsdom": "^26.1.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  }
}
