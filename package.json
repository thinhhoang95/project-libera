{
  "name": "project-libera",
  "productName": "Libera",
  "version": "0.3.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "cross-env LIBERA_ELECTRON_NEXT_MODE=dev electron .",
    "electron:prepare-standalone": "node electron/prepare-standalone.cjs",
    "electron:prepare-dist": "node electron/prepare-dist.cjs",
    "electron:start": "npm run build && npm run electron:prepare-standalone && cross-env LIBERA_ELECTRON_NEXT_MODE=start electron .",
    "electron:dist": "npm run build && npm run electron:prepare-standalone && npm run electron:prepare-dist && electron-builder --config electron-builder.json",
    "lint": "eslint"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "electron": "^37.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
