{
  "name": "libera-collab-server",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaboration server for Libera (sync, accounts, comments, suggestions, reviews).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node scripts/build.mjs",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "admin": "tsx src/admin/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "kysely": "^0.29.7",
    "lib0": "^0.2.119",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
