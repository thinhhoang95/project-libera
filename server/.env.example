# Copy to server/.env (gitignored). Every variable is documented in SETUP.md.
NODE_ENV=development
HOST=127.0.0.1
PORT=4400
PUBLIC_URL=http://127.0.0.1:4400

# pglite://./data/pglite (embedded, development) or postgres://user:pass@host:5432/libera
DATABASE_URL=pglite://./data/pglite

# Use a random value of at least 32 characters in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=development-only-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=14
ALLOW_OPEN_SIGNUP=1

BLOB_DRIVER=disk
BLOB_DIR=./data/blobs
# BLOB_S3_ENDPOINT=http://127.0.0.1:9000
# BLOB_S3_REGION=us-east-1
# BLOB_S3_BUCKET=libera-blobs
# BLOB_S3_ACCESS_KEY=
# BLOB_S3_SECRET_KEY=
MAX_BLOB_BYTES=104857600

# Unset: emails (invitations, digests) are written to the log instead.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=Libera <no-reply@libera.local>

# MIN_PROTOCOL_VERSION=1
MIN_APP_VERSION=0.0.0
# METRICS_TOKEN=
SYNC_CONNECTIONS_PER_MINUTE=60
SYNC_MAX_SOCKETS_PER_ACCOUNT=8
SNAPSHOT_EVERY_UPDATES=2000
LOG_RETENTION_DAYS=90
ROOM_IDLE_MS=60000
LOG_LEVEL=info
# Sentry-compatible DSN (GlitchTip) for error reports. Unset: errors are only logged.
# ERROR_REPORT_DSN=https://key@glitchtip.example.com/1
# ERROR_REPORT_ENVIRONMENT=development
TRUST_PROXY=0
